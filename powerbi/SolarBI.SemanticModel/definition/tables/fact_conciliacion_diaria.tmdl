table fact_conciliacion_diaria
	lineageTag: c79fabf6-4944-4bbc-85b7-d85bdc220b32

	measure 'Disponibilidad día %' = AVERAGE(fact_conciliacion_diaria[disponibilidad_pct])
		formatString: #,0.0
		displayFolder: Calidad
		lineageTag: 8b0a6f0e-1c11-4a3e-9d1e-0c2b7a1f0001

	measure 'Desviación PV día %' = AVERAGE(fact_conciliacion_diaria[desv_pv_pct])
		formatString: #,0.0
		displayFolder: Calidad
		lineageTag: 8b0a6f0e-1c11-4a3e-9d1e-0c2b7a1f0002

	measure 'Desviación conciliación PV %' = VAR d = FILTER(fact_conciliacion_diaria, NOT ISBLANK(fact_conciliacion_diaria[pv_kwh_contador]) && fact_conciliacion_diaria[pv_kwh_contador] > 0) RETURN DIVIDE(SUMX(d, fact_conciliacion_diaria[pv_kwh_integrado] - fact_conciliacion_diaria[pv_kwh_contador]), SUMX(d, fact_conciliacion_diaria[pv_kwh_contador]))
		formatString: 0.0%
		displayFolder: Calidad
		lineageTag: 90fc597c-cdfe-54b3-be71-91cf30218b59

	measure 'Días que concilian %' = DIVIDE(COUNTROWS(FILTER(fact_conciliacion_diaria, NOT ISBLANK(fact_conciliacion_diaria[desv_pv_pct]) && ABS(fact_conciliacion_diaria[desv_pv_pct]) <= 20)), COUNTROWS(FILTER(fact_conciliacion_diaria, NOT ISBLANK(fact_conciliacion_diaria[desv_pv_pct]))))
		formatString: 0.0%
		displayFolder: Calidad
		lineageTag: 73e2fd14-d430-52ae-8a7d-051d57ba0546

	column sk_fecha
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0dfc5c61-c6ba-4055-9f8d-6c29d85f90fe
		summarizeBy: none
		sourceColumn: sk_fecha

		annotation SummarizationSetBy = Automatic

	column sk_inversor
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 505e046a-d699-4d9c-8cc2-90f22bc009f5
		summarizeBy: none
		sourceColumn: sk_inversor

		annotation SummarizationSetBy = Automatic

