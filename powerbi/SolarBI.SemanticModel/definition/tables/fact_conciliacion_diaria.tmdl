	partition fact_conciliacion_diaria = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(ServidorPG, BaseDatosPG),
				    Tabla = Origen{[Schema="gold",Item="fact_conciliacion_diaria"]}[Data],
				    Columnas = Table.SelectColumns(Tabla, {"sk_fecha", "sk_inversor", "pv_kwh_integrado", "pv_kwh_contador", "carga_kwh_integrado", "uso_kwh_contador", "desv_pv_pct", "disponibilidad_pct"})
				in
