	partition fact_disponibilidad_diaria = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(ServidorPG, BaseDatosPG),
				    Tabla = Origen{[Schema="gold",Item="fact_disponibilidad_diaria"]}[Data],
				    Columnas = Table.SelectColumns(Tabla, {"sk_fecha", "sk_inversor", "lecturas_recibidas", "lecturas_validas", "seg_cubiertos", "seg_cubiertos_valid", "seg_periodo", "huecos_mayor_10min"})
				in
				    Columnas

	annotation PBI_ResultType = Table

