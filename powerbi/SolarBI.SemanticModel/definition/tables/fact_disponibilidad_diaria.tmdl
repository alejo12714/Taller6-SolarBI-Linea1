table fact_disponibilidad_diaria
	lineageTag: 8ad3c08a-5cd0-43ba-9ef5-781913f5fc9e

	measure 'Lecturas recibidas' = SUM(fact_disponibilidad_diaria[lecturas_recibidas])
		formatString: #,0
		displayFolder: Calidad
		lineageTag: 1a379cda-f9ae-599e-a86a-a776956baf5c

	measure 'Lecturas válidas' = SUM(fact_disponibilidad_diaria[lecturas_validas])
		formatString: #,0
		displayFolder: Calidad
		lineageTag: 46430136-423c-508a-ac0f-ffa21ee125d6

	measure 'Lecturas inválidas' = [Lecturas recibidas] - [Lecturas válidas]
		formatString: #,0
		displayFolder: Calidad
		lineageTag: d915e8a2-5642-5bf2-b6e2-e79906b7355b

	measure '% Lecturas válidas' = DIVIDE([Lecturas válidas], [Lecturas recibidas])
		formatString: 0.00%
		displayFolder: Calidad
		lineageTag: efaaae91-2a1e-56a3-81ac-19332f8ca32b

	measure 'Días en ventana de registro' = COUNTROWS(FILTER(dim_fecha, dim_fecha[fecha] >= DATE(2025, 7, 12) && dim_fecha[fecha] <= DATE(2026, 7, 13)))
		formatString: #,0
		displayFolder: Calidad
		lineageTag: 619ae5ee-78ff-509a-9bd0-07b25a988247

	measure 'Inversores en contexto' = COUNTROWS(FILTER(VALUES(dim_inversor[inversor_id]), dim_inversor[inversor_id] > 0))
		formatString: 0
		displayFolder: Calidad
		lineageTag: 10759168-b388-52b3-aae6-356cefb29b91

	measure 'Disponibilidad registro %' = DIVIDE(SUM(fact_disponibilidad_diaria[seg_cubiertos_valid]), [Días en ventana de registro] * 86400 * [Inversores en contexto])
		formatString: 0.0%
		displayFolder: Calidad
		lineageTag: 6648ef46-9c20-5824-b1fe-3e6df9ad7f1e

	measure 'Huecos > 10 min' = SUM(fact_disponibilidad_diaria[huecos_mayor_10min])
		formatString: #,0
		displayFolder: Calidad
		lineageTag: 2e09e143-c1da-5f4a-a84d-2c264ce289ca

	measure '% Válidas MM7' = AVERAGEX(DATESINPERIOD(dim_fecha[fecha], MAX(dim_fecha[fecha]), -7, DAY), [% Lecturas válidas])
		formatString: 0.00%
		displayFolder: Calidad
		lineageTag: 425ee909-45f0-5f17-a94f-e56d9e7cb91a

	column sk_fecha
