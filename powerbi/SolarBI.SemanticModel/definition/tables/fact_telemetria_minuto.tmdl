table fact_telemetria_minuto
	lineageTag: 984fe181-b551-4f1b-a028-a9e92e0a7f5f

	measure 'E PV kWh' = SUM(fact_telemetria_minuto[e_pv_kwh])
		formatString: #,0.0
		displayFolder: Energía
		lineageTag: 1b53ec62-3a8e-56d8-abb7-a6b178c561e0

	measure 'E Carga kWh' = SUM(fact_telemetria_minuto[e_carga_kwh])
		formatString: #,0.0
		displayFolder: Energía
		lineageTag: 00b7f311-547f-5e05-99f2-ab2deec94a4d

	measure 'E Red kWh' = SUM(fact_telemetria_minuto[e_red_kwh])
		formatString: #,0.0
		displayFolder: Energía
		lineageTag: d4e2c6f9-ee54-579b-8569-9be43ac86354

	measure 'E Bat Carga kWh' = SUM(fact_telemetria_minuto[e_bat_carga_kwh])
		formatString: #,0.0
		displayFolder: Energía
		lineageTag: 3bb76d72-2f03-5e9f-a874-275cabaf86d0

	measure 'E Bat Descarga kWh' = SUM(fact_telemetria_minuto[e_bat_descarga_kwh])
		formatString: #,0.0
		displayFolder: Energía
		lineageTag: 0d39398f-7873-51d2-8047-6efcd204fb59

	measure 'Autosuficiencia %' = DIVIDE([E Carga kWh] - MIN([E Red kWh], [E Carga kWh]), [E Carga kWh])
		formatString: 0.0%
		displayFolder: Híbridos
		lineageTag: 547b1f47-ef0a-56b2-859d-6af269fad0bd

	measure 'Red excedente kWh' = MAX(0, [E Red kWh] - [E Carga kWh])
		formatString: #,0.0
		displayFolder: Híbridos
		lineageTag: 155063b8-9c09-58ab-81a0-749fd0775b24

	measure 'Cobertura solar %' = DIVIDE([E PV kWh], [E Carga kWh])
		formatString: 0.0%
		displayFolder: Híbridos
		lineageTag: 707fae79-c1a0-539f-a492-3bd7f7e1078b

	measure 'Balance no explicado kWh' = ([E PV kWh] + [E Red kWh] + [E Bat Descarga kWh]) - ([E Carga kWh] + [E Bat Carga kWh])
		formatString: #,0.0
		displayFolder: Híbridos
		lineageTag: c98bc4dc-8142-5d6a-9405-2f156484787b

	measure 'Cierre del balance %' = DIVIDE([Balance no explicado kWh], [E PV kWh] + [E Red kWh] + [E Bat Descarga kWh])
		formatString: 0.0%
		displayFolder: Híbridos
		lineageTag: 2d178d54-6877-5270-9c61-5f055613f6aa

	measure 'Eficiencia aparente batería %' = DIVIDE([E Bat Descarga kWh], [E Bat Carga kWh])
		formatString: 0.0%
		displayFolder: Híbridos
		lineageTag: aaaa5fa6-904b-5384-83d4-29f9043bea55

	measure 'Ciclos equivalentes' = DIVIDE([E Bat Descarga kWh], MAX(dim_inversor[capacidad_bat_ah]) * 51.2 / 1000)
		formatString: #,0.0
		displayFolder: Híbridos
		lineageTag: 14070af7-6173-54c6-b003-86e06ba2e39a

	measure 'Dependencia nocturna de red %' = DIVIDE(CALCULATE([E Red kWh], dim_tiempo[es_ventana_solar] = FALSE()), [E Red kWh])
		formatString: 0.0%
		displayFolder: Híbridos
		lineageTag: 3427d1a6-79bd-559f-9928-28adf10ba28d

	measure 'E PV MTD' = TOTALMTD([E PV kWh], dim_fecha[fecha])
		formatString: #,0.0
		displayFolder: Inteligencia de tiempo
		lineageTag: fc1dcf08-f0e6-5375-b04a-73bf092ff6d7

	measure 'E PV YTD' = TOTALYTD([E PV kWh], dim_fecha[fecha])
		formatString: #,0.0
		displayFolder: Inteligencia de tiempo
		lineageTag: 26cc2937-9760-5ecd-8252-a96121be4613

	measure 'E PV mes anterior' = CALCULATE([E PV kWh], DATEADD(dim_fecha[fecha], -1, MONTH))
		formatString: #,0.0
		displayFolder: Inteligencia de tiempo
		lineageTag: 6150d70d-5c94-51bb-a1bc-e86af5390bd5

	measure 'Var PV MoM %' = DIVIDE([E PV kWh] - [E PV mes anterior], [E PV mes anterior])
		formatString: 0.0%
		displayFolder: Inteligencia de tiempo
		lineageTag: 5931a55f-1ed7-5aa9-aa07-183a0c1acd36

	measure 'Autosuficiencia mes anterior %' = CALCULATE([Autosuficiencia %], DATEADD(dim_fecha[fecha], -1, MONTH))
		formatString: 0.0%
		displayFolder: Inteligencia de tiempo
		lineageTag: 800aeda8-8e37-5fa2-998f-a1037fb8060c

	measure 'Costo red COP' = [E Red kWh] * [Valor Tarifa]
		formatString: $ #,0
		displayFolder: Económico
		lineageTag: 083f2196-dbb6-5efd-893d-5bc4771ea6aa

	measure 'Ahorro autosuficiencia COP' = ([E Carga kWh] - MIN([E Red kWh], [E Carga kWh])) * [Valor Tarifa]
		formatString: $ #,0
		displayFolder: Económico
		lineageTag: a2cd4de3-d6e0-5a1a-9b39-3a3f8945d0e2

	measure 'Ahorro YTD COP' = VAR ult = CALCULATE(MAX(dim_fecha[fecha]), fact_telemetria_minuto) RETURN CALCULATE([Ahorro autosuficiencia COP], DATESBETWEEN(dim_fecha[fecha], DATE(YEAR(ult), 1, 1), ult))
		formatString: $ #,0
		displayFolder: Económico
		lineageTag: ab06e24f-b466-5e0c-a017-367e760606fd

	measure 'E Red escenario kWh' = VAR f = [Valor Factor PV] RETURN SUMX(fact_telemetria_minuto, MAX(0, fact_telemetria_minuto[e_red_kwh] - (f - 1) * fact_telemetria_minuto[e_pv_kwh]))
		formatString: #,0.0
		displayFolder: Económico
		lineageTag: 06b64031-9300-544b-8f6d-06d635ae2da4

	measure 'Ahorro adicional escenario COP' = ([E Red kWh] - [E Red escenario kWh]) * [Valor Tarifa]
		formatString: $ #,0
		displayFolder: Económico
		lineageTag: 20c32e9f-cb45-57bd-843e-250c596d9b7c

