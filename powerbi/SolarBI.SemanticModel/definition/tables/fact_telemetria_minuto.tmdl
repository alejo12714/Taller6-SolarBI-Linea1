				    Tabla = Origen{[Schema="gold",Item="fact_telemetria_minuto"]}[Data],
				    Columnas = Table.SelectColumns(Tabla, {"sk_fecha", "sk_tiempo", "sk_inversor", "ts_minuto_utc", "n_lecturas", "n_validas", "seg_cubiertos", "seg_cubiertos_valid", "e_pv_kwh", "e_carga_kwh", "e_red_kwh", "e_bat_carga_kwh", "e_bat_descarga_kwh", "soc_prom_pct", "soc_min_pct", "p_pv_max_w", "origen"})
