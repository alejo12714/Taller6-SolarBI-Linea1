table fact_calidad_diaria
	lineageTag: 6263e3a1-c016-433d-8294-0d89a9bf56a1

	measure 'Lecturas evaluadas' = SUM(fact_calidad_diaria[lecturas_evaluadas])
		formatString: #,0
		displayFolder: Calidad
		lineageTag: ccafaa3d-80cb-54dc-9daa-65a0ed3f8ec5

	measure 'Lecturas afectadas' = SUM(fact_calidad_diaria[lecturas_afectadas])
		formatString: #,0
		displayFolder: Calidad
		lineageTag: 57f2373c-bbfc-50e9-bc83-6c80d6b61dfb

	measure 'Tasa violación regla %' = DIVIDE([Lecturas afectadas], [Lecturas evaluadas])
		formatString: 0.00%
		displayFolder: Calidad
		lineageTag: b79d6f63-04f5-5f62-9c2f-a1bb919d27fa

