{
  "uid": "solarbi-operativo",
  "title": "SolarBI · Operación de la microrred (near real-time)",
  "tags": [
    "solarbi",
    "microrred",
    "linea-1"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "inversor",
        "label": "Inversor",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "solarbi-pg"
        },
        "query": "SELECT DISTINCT inversor_id::text FROM gold.dim_inversor WHERE inversor_id > 0 ORDER BY 1",
        "definition": "SELECT DISTINCT inversor_id::text FROM gold.dim_inversor WHERE inversor_id > 0 ORDER BY 1",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Eventos",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "solarbi-pg"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "rawQuery": true,
          "format": "table",
          "refId": "Anno",
          "rawSql": "SELECT e.inicio_utc AS time, e.fin_utc AS timeend, t.codigo AS text FROM gold.fact_evento_operativo e JOIN gold.dim_tipo_evento t USING (sk_tipo_evento) WHERE $__timeFilter(e.inicio_utc)"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Estado actual por inversor",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "SoC actual",
      "type": "gauge",
      "description": "Estado de carga del último minuto recibido. Umbral rojo = ALERTA_SOC_MIN.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "solarbi-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-pg"
          },
          "rawSql": "SELECT 'Inv ' || inversor_id AS metric, soc_prom_pct AS value FROM gold.vw_estado_actual WHERE inversor_id IN (${inversor:csv}) ORDER BY 1",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "green",
                "value": 40
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        }
      }
    },
    {
      "id": 2,
      "title": "Potencias instantáneas (W)",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "solarbi-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-pg"
          },
          "rawSql": "SELECT 'Inv ' || inversor_id || ' PV' AS metric, p_pv_w AS value FROM gold.vw_estado_actual WHERE inversor_id IN (${inversor:csv}) UNION ALL SELECT 'Inv ' || inversor_id || ' Carga', p_carga_w FROM gold.vw_estado_actual WHERE inversor_id IN (${inversor:csv}) UNION ALL SELECT 'Inv ' || inversor_id || ' Red', p_red_w FROM gold.vw_estado_actual WHERE inversor_id IN (${inversor:csv}) ORDER BY 1",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        },
        "colorMode": "background"
      }
    },
    {
      "id": 3,
      "title": "Frescura del dato (s desde la última lectura)",
      "type": "stat",
      "description": "Rojo a 300 s = umbral de la alerta de frescura (≈ 2,7 × p99 de la cadencia histórica, 111 s).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "solarbi-pg"
      },
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 5,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-pg"
          },
          "rawSql": "SELECT 'Inv ' || inversor_id AS metric, segundos_desde_ultimo AS value FROM gold.vw_estado_actual WHERE inversor_id IN (${inversor:csv}) ORDER BY 1",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": null,
          "max": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 180
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        },
        "colorMode": "background"
      }
    },
    {
      "id": 4,
      "title": "% lecturas válidas (últimos 15 min) · Línea 1",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "solarbi-pg"
      },
      "gridPos": {
        "x": 19,
        "y": 1,
        "w": 5,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-pg"
          },
          "rawSql": "SELECT 'Inv ' || i.inversor_id AS metric, round(100.0 * sum(n_validas) / NULLIF(sum(n_lecturas), 0), 1) AS value FROM gold.fact_telemetria_minuto f JOIN gold.dim_inversor i USING (sk_inversor) WHERE f.ts_minuto_utc > now() - interval '15 minutes' AND i.inversor_id IN (${inversor:csv}) GROUP BY 1 ORDER BY 1",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 97
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        },
        "colorMode": "background"
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Series de tiempo",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "title": "Balance de potencia (W promedio por minuto)",
      "type": "timeseries",
      "description": "Potencia media = energía del minuto × 60 000. spanNulls=3 min: no une huecos reales.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "solarbi-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-pg"
          },
          "rawSql": "SELECT f.ts_minuto_utc AS time, 'Inv ' || i.inversor_id || ' · PV' AS metric, f.e_pv_kwh * 60000 AS value FROM gold.fact_telemetria_minuto f JOIN gold.dim_inversor i USING (sk_inversor) WHERE $__timeFilter(f.ts_minuto_utc) AND i.inversor_id IN (${inversor:csv}) UNION ALL SELECT f.ts_minuto_utc, 'Inv ' || i.inversor_id || ' · Carga', f.e_carga_kwh * 60000 FROM gold.fact_telemetria_minuto f JOIN gold.dim_inversor i USING (sk_inversor) WHERE $__timeFilter(f.ts_minuto_utc) AND i.inversor_id IN (${inversor:csv}) UNION ALL SELECT f.ts_minuto_utc, 'Inv ' || i.inversor_id || ' · Red', f.e_red_kwh * 60000 FROM gold.fact_telemetria_minuto f JOIN gold.dim_inversor i USING (sk_inversor) WHERE $__timeFilter(f.ts_minuto_utc) AND i.inversor_id IN (${inversor:csv}) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": 180000
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Estado de carga (%)",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "solarbi-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-pg"
          },
          "rawSql": "SELECT f.ts_minuto_utc AS time, 'Inv ' || i.inversor_id AS metric, f.soc_prom_pct AS value FROM gold.fact_telemetria_minuto f JOIN gold.dim_inversor i USING (sk_inversor) WHERE $__timeFilter(f.ts_minuto_utc) AND i.inversor_id IN (${inversor:csv}) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "transparent",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Calidad por minuto: lecturas recibidas vs válidas",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "solarbi-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-pg"
          },
          "rawSql": "SELECT f.ts_minuto_utc AS time, 'Inv ' || i.inversor_id || ' · recibidas' AS metric, f.n_lecturas AS value FROM gold.fact_telemetria_minuto f JOIN gold.dim_inversor i USING (sk_inversor) WHERE $__timeFilter(f.ts_minuto_utc) AND i.inversor_id IN (${inversor:csv}) UNION ALL SELECT f.ts_minuto_utc, 'Inv ' || i.inversor_id || ' · válidas', f.n_validas FROM gold.fact_telemetria_minuto f JOIN gold.dim_inversor i USING (sk_inversor) WHERE $__timeFilter(f.ts_minuto_utc) AND i.inversor_id IN (${inversor:csv}) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Eventos operativos recientes",
      "type": "table",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "solarbi-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 17,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-pg"
          },
          "rawSql": "SELECT e.inicio_utc AS \"Inicio\", 'Inv ' || i.inversor_id AS \"Inversor\", t.codigo AS \"Evento\", t.severidad AS \"Severidad\", round(e.duracion_s / 60, 1) AS \"Min\" FROM gold.fact_evento_operativo e JOIN gold.dim_inversor i USING (sk_inversor) JOIN gold.dim_tipo_evento t USING (sk_tipo_evento) WHERE $__timeFilter(e.inicio_utc) AND i.inversor_id IN (${inversor:csv}) ORDER BY 1 DESC LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}